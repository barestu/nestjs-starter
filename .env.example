PORT=3000
APP_NAME=NestJS Starter
FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_starter

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=*
ENABLE_SWAGGER=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=secret
SMTP_FROM="App Name <no-reply@example.com>"

# S3 / MinIO — local dev defaults (docker compose spins up MinIO automatically)
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_BUCKET=nestjs-starter
# Production S3: remove AWS_ENDPOINT, set real credentials above
